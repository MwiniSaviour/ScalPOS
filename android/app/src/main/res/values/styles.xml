<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- SystemBars.setStyle() repaints the decorView from this attr; a dark
             windowBackground keeps that repaint dark instead of DayNight's white -->
        <item name="android:windowBackground">@color/nova_window_bg</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- dark brand background on both the 12+ system splash (windowSplashScreenBackground)
             and the pre-12 windowBackground drawable — a white splash flashing into the dark
             app reads as a jarring "marketing page" flash -->
        <item name="android:windowSplashScreenBackground">@color/nova_window_bg</item>
        <item name="windowSplashScreenBackground">@color/nova_window_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/nova_window_bg</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/nova_window_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>