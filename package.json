{
  "name": "scalpos",
  "version": "1.3.0",
  "private": true,
  "description": "Nova POS - offline-first mobile point of sale for Ghana retail",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack --hostname 0.0.0.0 -p 3000",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "cap:android": "cap sync android && cd android && ./gradlew assembleDebug",
    "backend:start": "cd backend && supabase start",
    "backend:stop": "cd backend && supabase stop",
    "backend:test": "cd backend && supabase test db",
    "backend:reset": "cd backend && supabase db reset",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@clerk/clerk-react": "^5.61.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
